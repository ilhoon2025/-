-- K부대 (군대 게임 모드) 화면
-------------------------------------------------------------------
local armyMode = false
local armyGui = new("ScreenGui", { Name = "ArmyUI", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, Parent = player:WaitForChild("PlayerGui") })
local armyHud = new("Frame", { Parent = armyGui, BackgroundColor3 = Color3.fromRGB(40, 48, 32), BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromScale(0.42, 0.13), Position = UDim2.fromScale(0.5, 0.02) }, { corner(12), stroke(Color3.fromRGB(150, 160, 110), 2) })
local armyRank = text({ Parent = armyHud, Text = "이병", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(255, 220, 90), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.25, 0.8), Position = UDim2.fromScale(0.02, 0.1) })
local armyMission = text({ Parent = armyHud, Text = "", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(235, 240, 220), Size = UDim2.fromScale(0.68, 0.3), Position = UDim2.fromScale(0.3, 0.06) })
local armyDesc = text({ Parent = armyHud, Text = "", Font = F.mid, TextScaled = true, TextColor3 = Color3.fromRGB(255, 230, 150), Size = UDim2.fromScale(0.68, 0.26), Position = UDim2.fromScale(0.3, 0.38) })
local armyProg = text({ Parent = armyHud, Text = "", Font = F.mid, TextScaled = true, TextColor3 = Color3.fromRGB(190, 200, 160), Size = UDim2.fromScale(0.68, 0.24), Position = UDim2.fromScale(0.3, 0.7) })
-- 다음에 갈 곳 표시 (내 화면에만 보이는 빛기둥)
local armyMarker = Instance.new("Part")
armyMarker.Anchored = true
armyMarker.CanCollide = false
armyMarker.CanQuery = false
armyMarker.CanTouch = false
armyMarker.Material = Enum.Material.Neon
armyMarker.Color = Color3.fromRGB(80, 200, 255)
armyMarker.Transparency = 0.45
armyMarker.Size = Vector3.new(4, 30, 4)
armyMarker.Shape = Enum.PartType.Block
text({ Parent = armyGui, Text = "마우스 왼쪽 클릭: 사격   ·   파란 빛기둥: 가야 할 곳   ·   훈련 25개: 이병 → 일병 → 상병 → 병장 → 전역", Font = F.mid, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromScale(0.6, 0.03), Position = UDim2.fromScale(0.5, 0.98) })
-- 조준점
local cross = new("Frame", { Parent = armyGui, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(24, 24), Position = UDim2.fromScale(0.5, 0.5) })
new("Frame", { Parent = cross, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 24), Position = UDim2.fromScale(0.5, 0.5) })
new("Frame", { Parent = cross, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(24, 2), Position = UDim2.fromScale(0.5, 0.5) })
local mouse = player:GetMouse()
RunService.RenderStepped:Connect(function()
	if armyMode then
		cross.Position = UDim2.fromOffset(mouse.X, mouse.Y + 36)
	end
end)
local armyToast = text({ Parent = armyGui, Text = "", Font = F.bold, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = Color3.fromRGB(30, 35, 25), BackgroundTransparency = 0.2, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromScale(0.5, 0.05), Position = UDim2.fromScale(0.5, 0.17), Visible = false })
local armyToastId = 0
local function armyToastShow(msg)
	armyToastId = armyToastId + 1
	local my = armyToastId
	armyToast.Text = msg
	armyToast.Visible = true
	task.delay(2.5, function()
		if armyToastId == my then
			armyToast.Visible = false
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not armyMode then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local char = player.Character
		if char and char:FindFirstChild("소총") then
			remote:FireServer("Shoot", mouse.Hit.Position)
		end
	end
end)

-- 입대 장면
local function sceneEnlist()
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.fromRGB(40, 48, 32)
	local t1 = eText("그리고 몇 년 뒤…", 0.06, Color3.fromRGB(220, 225, 200), 0.3, F.mid, 160)
	fadeIn(t1)
	task.wait(1.5)
	local t2 = eText("입대 날이 왔다. 배치받은 곳은… K부대.", 0.07, Color3.fromRGB(255, 220, 90), 0.45, F.bold, 160)
	fadeIn(t2)
	task.wait(1)
	local go = button({ Parent = endingLayer, ZIndex = 160, Text = "입대하기", Font = F.bold, TextScaled = true, BackgroundColor3 = Color3.fromRGB(90, 110, 60), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.2, 0.08), Position = UDim2.fromScale(0.5, 0.7) })
	new("UIPadding", { Parent = go, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
	local done = false
	go.MouseButton1Click:Connect(function()
		done = true
	end)
	repeat
		task.wait()
	until done
end

-- 전역 화면
local armyEndLayer = new("Frame", { Parent = armyGui, BackgroundColor3 = Color3.fromRGB(40, 48, 32), Size = UDim2.fromScale(1, 1), ZIndex = 50, Visible = false })
text({ Parent = armyEndLayer, ZIndex = 51, Text = "전역을 축하합니다!", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(255, 220, 90), TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.7, 0.12), Position = UDim2.fromScale(0.5, 0.35) })
local armyEndDesc = text({ Parent = armyEndLayer, ZIndex = 51, Text = "", Font = F.mid, TextScaled = true, TextColor3 = Color3.fromRGB(220, 225, 200), TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.7, 0.045), Position = UDim2.fromScale(0.5, 0.48) })
local armyBack = button({ Parent = armyEndLayer, ZIndex = 51, Text = "학교로 돌아가기", Font = F.bold, TextScaled = true, BackgroundColor3 = Color3.fromRGB(90, 110, 60), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.24, 0.08), Position = UDim2.fromScale(0.5, 0.65) })
new("UIPadding", { Parent = armyBack, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
armyBack.MouseButton1Click:Connect(function()
	armyEndLayer.Visible = false
	armyGui.Enabled = false
	armyMode = false
	UserInputService.MouseIconEnabled = true
	-- 영화처럼 엔딩 크레딧을 보고 학교로
	playCredits()
	root.Visible = true
	remote:FireServer("LeaveArmy")
end)

local function startArmy()
	armyMode = true
	root.Visible = false
	armyGui.Enabled = true
	armyHud.Visible = true
	remote:FireServer("EnlistArmy")
end

local function playEnding()
	root.Visible = false
	endingLayer.Visible = true
	-- 매번 새로 섞은 50문제씩
	local r = Random.new()
	local snuRows = table.clone(SNU_ROWS)
	while #snuRows < 50 do
		table.insert(snuRows, genMathRow(r))
	end
	SNU_QUESTIONS = buildQuiz(snuRows, r)
	EXTRA_EXAMS.army.questions = buildQuiz(ARMY_ROWS, r)
	EXTRA_EXAMS.life.questions = buildQuiz(LIFE_ROWS, r)
	EXTRA_EXAMS.heaven.questions = buildQuiz(HEAVEN_ROWS, r)
	EXTRA_EXAMS.hallelujah.questions = buildQuiz(HALLE_ROWS, r)
	sceneUniversity()
	sceneSNUExam()
	sceneTwist()
	sceneInterview()
	local total, max = 0, 0
	for _, key in ipairs({ "army", "life" }) do
		local a, b = sceneQuiz(EXTRA_EXAMS[key])
		total, max = total + a, max + b
	end
	sceneExplosion()
	for _, key in ipairs({ "heaven", "hallelujah" }) do
		local a, b = sceneQuiz(EXTRA_EXAMS[key])
		total, max = total + a, max + b
	end
	sceneFinal(total, max)
	sceneDream()
	sceneEnlist()
	clearEnding()
	endingLayer.Visible = false
	setExamMode(false)
	status.Text = "고등학교 수업 시간"
	-- 마지막: K부대 군대 게임 시작
	startArmy()
end

remote.OnClientEvent:Connect(function(action, data, extra, extra2)
	if action == "Question" then
		if not inExam then
			setExamMode(true)
		end
		modal.Visible = false
		qNum, qTotal = data.num, data.total
		if data.num == 1 then
			timeLeft, suspicion = Shared.TIME_LIMIT, 0
		end
		paperNum.Text = data.seat .. "번 좌석"
		qLabel.Text = data.num .. ".  " .. data.text
		picked = nil
		paperMsg.Text = ""
		for i, b in ipairs(choiceBtns) do
			b.Text = Shared.NUM[i] .. "   " .. tostring(data.options[i])
			b.BackgroundColor3 = C.paper
			b.UIStroke.Color = C.line
			b.UIStroke.Thickness = 1
		end
		hintLabel.Text = ""
		updateStatus()
	elseif action == "Timer" then
		timeLeft, suspicion = data, extra
		updateStatus()
	elseif action == "CheatStart" then
		cheatDur = data
		cheatingUntil = os.clock() + data
		progBg.Visible = true
		hintLabel.TextColor3 = C.muted
		hintLabel.Text = "시도 중…"
	elseif action == "Hint" or action == "CheatCancel" then
		cheatingUntil = nil
		progBg.Visible = false
		if action == "Hint" then
			hintLabel.TextColor3 = C.ok
			hintLabel.Text = data
			if type(extra) == "table" and extra.ans then
				local c = cheats[selected]
				showCheatView(c and c.name or "", c and c.copy, extra.ans, extra)
			end
		end
	elseif action == "Domain" then
		cheatingUntil = nil
		progBg.Visible = false
		showDomain(data)
	elseif action == "Log" then
		table.insert(logs, 1, data)
		if #logs > 3 then
			table.remove(logs)
		end
		logLabel.Text = table.concat(logs, "\n")
	elseif action == "Away" then
		away = data
		leaveBtn.Text = away and "자리로 돌아가기" or "몰래 나가기"
		paper.Visible = not away
		cheatBtn.Visible = not away
		if away then
			toast("감독관 시야(빨간 빛)를 피해 문으로 나가세요. 돌아오면 자리 근처에서 버튼을 누르세요.")
		end
	elseif action == "NukeWarn" then
		toast(data .. " 님이 핵폭탄을 발사했습니다! " .. extra .. "초 후 도착! 교실 뒤 왼쪽 핵 벙커로 대피!")
		local warn = text({ Parent = gui, ZIndex = 190, Text = "핵폭탄 접근 중", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(255, 60, 60), TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.1), Position = UDim2.fromScale(0.5, 0.3) })
		task.spawn(function()
			for _ = 1, extra * 2 do
				warn.Visible = not warn.Visible
				task.wait(0.5)
			end
			warn:Destroy()
		end)
	elseif action == "FloodWarn" then
		toast(data .. " 님이 홍수를 일으켰습니다! 교실 뒤 사다리로 지붕에 대피!")
	elseif action == "NukeBoom" then
		local flash = new("Frame", { Parent = gui, ZIndex = 195, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1) })
		TweenService:Create(flash, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
		task.delay(2.6, function()
			flash:Destroy()
		end)
	elseif action == "Army" then
		armyRank.Text = data.rank
		armyMission.Text = data.mission
		armyDesc.Text = data.desc or ""
		armyProg.Text = data.progress ~= "" and ("진행: " .. data.progress) or ""
		if data.marker then
			armyMarker.Position = data.marker + Vector3.new(0, 15, 0)
			armyMarker.Parent = workspace
		else
			armyMarker.Parent = nil
		end
	elseif action == "ArmyEnd" then
		armyHud.Visible = false
		armyMarker.Parent = nil
		armyEndDesc.Text = "병장 " .. data .. ", K부대 훈련 25개를 모두 마치고 전역했습니다. 충성!"
		armyEndLayer.Visible = true
	elseif action == "Toast" and armyMode then
		armyToastShow(data)
	elseif action == "Toast" then
		toast(data)
	elseif action == "Inventory" then
		renderBag(data)
	elseif action == "Money" then
		showMoney(data)
	elseif action == "OpenProShop" then
		proMoney.Text = "가진 돈 " .. data .. "원"
		proBought = extra or proBought
		local c = cheats[selected]
		if c then
			customName.Text = c.name .. "  ·  " .. Shared.doubled(Shared.proPrice(c.name), proBought) .. "원"
		else
			customName.Text = "왼쪽에서 물건을 고르세요"
		end
		refreshProButtons()
		proShop.Visible = true
	elseif action == "Upgrades" then
		perkLv = data.perks or {}
		gearLv = data.gear or {}
		for i, c in ipairs(cheats) do
			cheats[i] = Shared.makeCheat(c.name, owned[c.name], gearLv[c.name])
		end
		renderCheats()
		refreshUpShop()
	elseif action == "OpenUpShop" then
		upMoney.Text = "가진 돈 " .. data .. "원"
		refreshUpShop()
		upShop.Visible = true
	elseif action == "Owned" then
		proBought = extra2 or proBought
		owned = {}
		for _, n in ipairs(data) do
			owned[n] = true
		end
		for i, c in ipairs(cheats) do
			cheats[i] = Shared.makeCheat(c.name, owned[c.name], gearLv[c.name])
		end
		if extra then
			addCheat(extra)
		end
		renderCheats()
		refreshProButtons()
	elseif action == "OpenShop" then
		showMoney(data)
		shop.Visible = true
	elseif action == "End" then
		cheatingUntil = nil
		away = false
		progBg.Visible = false
		paper.Visible = false
		if data.reason == "flood" then
			mTitle.Text = "홍수"
			mGrade.Text = "익사"
			mGrade.TextColor3 = C.danger
			mDesc.Text = string.format("시험장이 물에 잠겼다.\n푼 문제 %d개 중 %d개 정답", data.answered, data.score)
		elseif data.reason == "nuke" then
			mTitle.Text = "핵폭탄"
			mGrade.Text = "전멸"
			mGrade.TextColor3 = C.danger
			mDesc.Text = string.format("누군가 핵폭탄을 쐈다. 시험장이 사라졌다.\n푼 문제 %d개 중 %d개 정답", data.answered, data.score)
		elseif data.reason == "sniper" then
			mTitle.Text = "저격당함"
			mGrade.Text = "실격"
			mGrade.TextColor3 = C.danger
			mDesc.Text = string.format("몰래 나갔다가 지붕 위 저격수에게 맞았습니다.\n푼 문제 %d개 중 %d개 정답", data.answered, data.score)
		elseif data.reason == "car" then
			mTitle.Text = "교통사고"
			mGrade.Text = "실격"
			mGrade.TextColor3 = C.danger
			mDesc.Text = string.format("시험 중 몰래 나갔다가 차에 치였습니다.\n푼 문제 %d개 중 %d개 정답", data.answered, data.score)
		elseif data.reason == "caught" then
			mTitle.Text = "부정행위 적발"
			mGrade.Text = "실격"
			mGrade.TextColor3 = C.danger
			mDesc.Text = string.format("가루가 되었습니다.\n푼 문제 %d개 중 %d개 정답", data.answered, data.score)
		else
			mTitle.Text = data.timeUp and "시험 시간 종료" or "시험 종료"
			mGrade.Text = data.grade .. "등급"
			mGrade.TextColor3 = C.accent
			mDesc.Text = string.format("%d문제 중 %d개 정답", Shared.TOTAL_Q, data.score)
			if data.grade == 1 then
				-- 1등급 엔딩
				task.spawn(playEnding)
				return
			end
		end
		modal.Visible = true
	end
end)

updateStatus()
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
