local picked = nil
for i = 1, 5 do
	local b = new("TextButton", {
		Parent = paper,
		Text = "",
		Font = F.reg,
		TextSize = 16,
		TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Left,
