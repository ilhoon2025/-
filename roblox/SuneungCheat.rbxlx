local function sceneQuiz(cfg)
	clearEnding()
	endingLayer.BackgroundColor3 = cfg.bg
	if cfg == EXTRA_EXAMS.heaven or cfg == EXTRA_EXAMS.hallelujah then
		-- 구름
		for i = 1, 7 do
			local cl = new("Frame", { Parent = endingLayer, ZIndex = 151, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.2, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.12 + (i % 3) * 0.04, 0.08), Position = UDim2.fromScale((i - 0.5) / 7, i % 2 == 0 and 0.9 or 0.96) })
			corner(1000).Parent = cl
		end
	end
	local t = eText(cfg.title, 0.08, cfg.titleColor, 0.1, F.bold, 160)
	fadeIn(t)
	local sub = eText(cfg.sub, 0.035, cfg.subColor, 0.19, F.mid, 160)
	local paperF = new("Frame", { Parent = endingLayer, ZIndex = 160, BackgroundColor3 = C.paper, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.5, 0.26) }, { corner(10), stroke() })
	local qL = text({ Parent = paperF, ZIndex = 161, Text = "", Font = F.bold, TextScaled = true, Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.05) })
	local resultL = text({ Parent = paperF, ZIndex = 161, Text = "", Font = F.mid, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.9, 0.08), Position = UDim2.fromScale(0.05, 0.88) })
	local btns = {}
	for i = 1, 4 do
		local b = button({ Parent = paperF, ZIndex = 161, Text = "", Font = F.mid, TextScaled = true, BackgroundColor3 = C.paper, TextColor3 = C.text, Size = UDim2.fromScale(0.9, 0.13), Position = UDim2.fromScale(0.05, 0.24 + (i - 1) * 0.16) }, false)
		new("UIPadding", { Parent = b, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
		btns[i] = b
	end
	local score = 0
	for n, item in ipairs(cfg.questions) do
		qL.Text = "[" .. n .. "/" .. #cfg.questions .. "]  " .. item.q
		for i, b in ipairs(btns) do
			b.Text = Shared.NUM[i] .. "  " .. item.a[i]
			b.BackgroundColor3 = C.paper
		end
		local chosen
		local conns = {}
		for i, b in ipairs(btns) do
			conns[i] = b.MouseButton1Click:Connect(function()
				chosen = chosen or i
			end)
		end
		repeat
			task.wait()
		until chosen
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		local ok = chosen == item.c
		if ok then
			score = score + 1
		end
		btns[item.c].BackgroundColor3 = Color3.fromRGB(210, 240, 215)
		if not ok then
			btns[chosen].BackgroundColor3 = Color3.fromRGB(250, 215, 215)
		end
		resultL.TextColor3 = ok and C.ok or C.danger
		resultL.Text = ok and "정답" or "오답"
		task.wait(0.5)
		resultL.Text = ""
	end
	paperF:Destroy()
	sub:Destroy()
	local total = #cfg.questions
	local r = eText(cfg.title .. " " .. score .. " / " .. total, 0.08, cfg.titleColor, 0.45, F.bold, 160)
	fadeIn(r)
	eText(score >= math.ceil(total * 0.7) and cfg.good or cfg.bad, 0.045, cfg.subColor, 0.56, F.mid, 160)
	task.wait(3)
	return score, total
end

-- 맨 마지막: 모든 시험 결과
local function sceneFinal(score, total)
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.fromRGB(255, 248, 220)
	local ok = score >= math.ceil(total * 0.7)
	local t = eText(ok and "할렐루야!" or "환생", 0.14, ok and Color3.fromRGB(200, 140, 0) or Color3.fromRGB(80, 80, 90), 0.38, F.bold, 160)
	fadeIn(t, 1)
	local d = eText(ok and "모든 시험을 통과하고 천국에 들어갔다. 더 이상 시험은 없다." or "다시 태어났다. 눈을 떠 보니… 수능 시험장이다.", 0.045, Color3.fromRGB(90, 80, 60), 0.52, F.mid, 160)
	fadeIn(d, 1.5)
	eText("전체 시험 " .. score .. " / " .. total, 0.04, Color3.fromRGB(120, 110, 90), 0.6, F.mid, 160)
	local back = button({ Parent = endingLayer, ZIndex = 160, Text = "다음", Font = F.bold, TextScaled = true, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.18, 0.07), Position = UDim2.fromScale(0.5, 0.78) })
	new("UIPadding", { Parent = back, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
	local done = false
	back.MouseButton1Click:Connect(function()
		done = true
	end)
	repeat
		task.wait()
	until done
end

-- 폭발 장면
local function sceneExplosion()
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.new(1, 1, 1)
	endingLayer.BackgroundTransparency = 0
	remote:FireServer("Explode")
	-- 불꽃 원이 퍼져 나감
	local fireColors = { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 170, 40), Color3.fromRGB(240, 80, 20), Color3.fromRGB(120, 30, 10) }
	for i, col in ipairs(fireColors) do
		local ring = new("Frame", { Parent = endingLayer, ZIndex = 155 + (5 - i), BackgroundColor3 = col, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0, 0) })
		new("UIAspectRatioConstraint", { Parent = ring, AspectRatio = 1 })
		corner(1000).Parent = ring
		TweenService:Create(ring, TweenInfo.new(0.5 + i * 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1.2 + i * 0.4, 1.2 + i * 0.4) }):Play()
	end
	-- 파편
	for _ = 1, 40 do
		local a = math.random() * math.pi * 2
		local d = 0.4 + math.random() * 0.4
		local bit = new("Frame", { Parent = endingLayer, ZIndex = 170, BackgroundColor3 = fireColors[math.random(1, 3)], BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.random(8, 20), math.random(8, 20)), Rotation = math.random(0, 360) })
		TweenService:Create(bit, TweenInfo.new(0.8 + math.random() * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5 + math.cos(a) * d, 0.5 + math.sin(a) * d), Rotation = math.random(-720, 720), BackgroundTransparency = 1 }):Play()
	end
	local boom = eText("펑!!!", 0.25, Color3.fromRGB(255, 255, 255), 0.5, F.bold, 180)
	boom.TextStrokeTransparency = 0
	boom.TextStrokeColor3 = Color3.fromRGB(120, 20, 0)
	-- 화면 흔들기
	local t0 = os.clock()
	while os.clock() - t0 < 1.6 do
		local k = 1 - (os.clock() - t0) / 1.6
		endingLayer.Position = UDim2.fromOffset(math.random(-12, 12) * k, math.random(-12, 12) * k)
		task.wait()
	end
	endingLayer.Position = UDim2.fromOffset(0, 0)
	task.wait(0.4)
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.new(0, 0, 0)
	local dead = eText("사망", 0.12, Color3.fromRGB(200, 30, 30), 0.45, F.bold, 160)
	fadeIn(dead, 1)
	local why = eText("인생 최고의 순간에 폭발했다.", 0.04, Color3.fromRGB(180, 180, 180), 0.57, F.mid, 160)
	fadeIn(why, 1.5)
	task.wait(3.5)
end

-- 장면 2: 인줄 알았는데.......
local function sceneTwist()
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.new(0, 0, 0)
	local line = "인줄 알았는데......."
	local label = eText("", 0.09, Color3.new(1, 1, 1), 0.5, F.bold, 160)
	local chars = {}
	for _, c in utf8.codes(line) do
		table.insert(chars, utf8.char(c))
	end
	for i = 1, #chars do
		label.Text = table.concat(chars, "", 1, i)
		task.wait(i <= 6 and 0.18 or 0.32)
	end
	task.wait(1.5)
end

-- 장면 3: 회사 면접
local function sceneInterview()
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.fromRGB(225, 228, 235)
	eText("삼성 회사 면접장", 0.06, Color3.fromRGB(30, 40, 80), 0.07, F.bold, 160)
	-- 벽, 책상, 면접관 3명 (블록 캐릭터)
	eBox(Color3.fromRGB(200, 205, 215), UDim2.fromScale(1, 0.45), UDim2.fromScale(0.5, 0.6), 151)
	local suit = { Color3.fromRGB(40, 45, 60), Color3.fromRGB(30, 30, 35), Color3.fromRGB(55, 60, 80) }
	for i, x in ipairs({ 0.3, 0.5, 0.7 }) do
		eBox(suit[i], UDim2.fromScale(0.1, 0.14), UDim2.fromScale(x, 0.52), 152, 10)
		local head = eBox(Color3.fromRGB(240, 205, 175), UDim2.fromScale(0.06, 0.1), UDim2.fromScale(x, 0.39), 153, 40)
		new("UIAspectRatioConstraint", { Parent = head, AspectRatio = 1 })
		local eyes = text({ Parent = head, ZIndex = 154, Text = "-  -", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(30, 30, 30), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.3) })
		eyes.TextTransparency = 0
	end
	eBox(Color3.fromRGB(120, 85, 55), UDim2.fromScale(0.62, 0.08), UDim2.fromScale(0.5, 0.6), 155, 6)

	local qPanel = new("Frame", { Parent = endingLayer, ZIndex = 160, BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromScale(0.7, 0.34), Position = UDim2.fromScale(0.5, 0.63) }, { corner(12), stroke() })
	local qLabel2 = text({ Parent = qPanel, ZIndex = 161, Text = "", Font = F.bold, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.92, 0.2), Position = UDim2.fromScale(0.04, 0.05) })
	local btns = {}
	for i = 1, 3 do
		local b = button({ Parent = qPanel, ZIndex = 161, Text = "", Font = F.mid, TextScaled = true, BackgroundColor3 = C.sub, TextColor3 = C.text, Size = UDim2.fromScale(0.9, 0.19), Position = UDim2.fromScale(0.05, 0.3 + (i - 1) * 0.23) }, false)
		new("UIPadding", { Parent = b, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
		btns[i] = b
	end

	local score, confessed = 0, false
	for _, item in ipairs(INTERVIEW) do
		qLabel2.Text = "면접관: \"" .. item.q .. "\""
		local chosen = nil
		local conns = {}
		for i, b in ipairs(btns) do
			b.Text = item.a[i][1]
			conns[i] = b.MouseButton1Click:Connect(function()
				chosen = item.a[i][2]
			end)
		end
		repeat
			task.wait()
		until chosen ~= nil
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		if chosen == "confess" then
			confessed = true
			break
		end
		score = score + chosen
	end
	qPanel:Destroy()

	local title2, desc
	if confessed then
		title2, desc = "불합격", "면접관: \"부정행위 자백 감사합니다.\" 서울대 합격도 취소되었다."
	elseif score >= 3 then
		title2, desc = "최종 합격!", "축하합니다. 내일부터 출근하세요."
	else
		title2, desc = "불합격", "면접관: \"다음 기회에…\" 내년에 다시 도전하자."
	end
	local r1 = eText(title2, 0.1, confessed and C.danger or (score >= 3 and C.ok or C.danger), 0.72, F.bold, 160)
	local r2 = eText(desc, 0.04, Color3.fromRGB(40, 45, 60), 0.82, F.mid, 160)
	fadeIn(r1)
	fadeIn(r2, 1)
	local back = button({ Parent = endingLayer, ZIndex = 160, Text = "확인", Font = F.bold, TextScaled = true, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.18, 0.07), Position = UDim2.fromScale(0.5, 0.92) })
	new("UIPadding", { Parent = back, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
	local done = false
	back.MouseButton1Click:Connect(function()
		done = true
	end)
	repeat
		task.wait()
	until done
end

-- 진짜 마지막: "아.... 꿈이였구나" → 고등학교 수업 시간
local function sceneDream()
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.new(0, 0, 0)
	local line = "아.... 꿈이였구나"
	local label = eText("", 0.08, Color3.new(1, 1, 1), 0.5, F.bold, 160)
	local chars = {}
	for _, c in utf8.codes(line) do
		table.insert(chars, utf8.char(c))
	end
	for i = 1, #chars do
		label.Text = table.concat(chars, "", 1, i)
		task.wait((chars[i] == ".") and 0.35 or 0.15)
	end
	task.wait(2)

	-- 고등학교 수업 시간 (교실 그림)
	clearEnding()
	endingLayer.BackgroundColor3 = Color3.fromRGB(232, 226, 205)
	local board = eBox(Color3.fromRGB(31, 77, 58), UDim2.fromScale(0.6, 0.32), UDim2.fromScale(0.5, 0.42), 152, 6)
	stroke(Color3.fromRGB(120, 90, 60), 6).Parent = board
	text({ Parent = board, ZIndex = 153, Text = "3교시  수학\nf(x) = x²  →  f'(x) = 2x", Font = F.bold, TextScaled = true, TextColor3 = Color3.fromRGB(235, 245, 238), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	-- 선생님 (블록 그림)
	eBox(Color3.fromRGB(60, 70, 110), UDim2.fromScale(0.07, 0.16), UDim2.fromScale(0.85, 0.62), 154, 8)
	local th = eBox(Color3.fromRGB(240, 205, 175), UDim2.fromScale(0.05, 0.09), UDim2.fromScale(0.85, 0.47), 155, 40)
	new("UIAspectRatioConstraint", { Parent = th, AspectRatio = 1 })
	-- 책상 줄
	for row = 0, 1 do
		for col = 0, 4 do
			eBox(Color3.fromRGB(150, 115, 80), UDim2.fromScale(0.12, 0.06), UDim2.fromScale(0.14 + col * 0.18, 0.78 + row * 0.12), 153, 4)
		end
	end
	-- 엎드려 자던 나 (가운데 앞자리)
	local me = eBox(Color3.fromRGB(76, 110, 245), UDim2.fromScale(0.06, 0.05), UDim2.fromScale(0.5, 0.73), 156, 8)
	me.Name = "Me"
	local bubble = new("Frame", { Parent = endingLayer, ZIndex = 160, BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromScale(0.36, 0.12), Position = UDim2.fromScale(0.82, 0.4) }, { corner(14), stroke() })
	text({ Parent = bubble, ZIndex = 161, Text = "거기! 수업 시간에 자면 어떡해!\n수능 얼마 안 남았다!", Font = F.bold, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	local cap = eText("고등학교 3학년 · 수업 시간", 0.05, Color3.fromRGB(80, 60, 40), 0.1, F.bold, 160)
	fadeIn(cap)
	local back = button({ Parent = endingLayer, ZIndex = 160, Text = "수업 듣기", Font = F.bold, TextScaled = true, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.18, 0.07), Position = UDim2.fromScale(0.5, 0.95) })
	new("UIPadding", { Parent = back, PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) })
	local done = false
	back.MouseButton1Click:Connect(function()
		done = true
	end)
	repeat
		task.wait()
	until done

	-- 내 화면의 교실 칠판도 수업 시간으로 바뀜 (나만 보임)
	local w = workspace:FindFirstChild("SuneungWorld")
	local bb = w and w:FindFirstChild("Blackboard")
	local sg = bb and bb:FindFirstChildOfClass("SurfaceGui")
	local tl = sg and sg:FindFirstChildOfClass("TextLabel")
	if tl then
		tl.Text = "3교시 수학\n수업 중에 졸지 맙시다"
	end
end

-------------------------------------------------------------------
-- 영화 같은 엔딩 크레딧: 한국 수능 부정행위
-------------------------------------------------------------------
local function playCredits()
	local cg = new("ScreenGui", { Name = "Credits", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, Parent = player:WaitForChild("PlayerGui") })
	local bg = new("Frame", { Parent = cg, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1 })
	-- 영화 화면 같은 위아래 검은 띠
	local barTop = new("Frame", { Parent = cg, BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 0), ZIndex = 10 })
	local barBot = new("Frame", { Parent = cg, BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), ZIndex = 10 })
	TweenService:Create(barTop, TweenInfo.new(1.2), { Size = UDim2.fromScale(1, 0.12) }):Play()
	TweenService:Create(barBot, TweenInfo.new(1.2), { Size = UDim2.fromScale(1, 0.12) }):Play()
	task.wait(1.4)
	TweenService:Create(bg, TweenInfo.new(1.5), { BackgroundTransparency = 0 }):Play()
	task.wait(1.6)

	local function big(str, size, color, y, font)
		return text({ Parent = cg, ZIndex = 5, Text = str, Font = font or F.bold, TextScaled = true, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(0.8, size), Position = UDim2.fromScale(0.5, y) })
	end
	-- 제목
	local title = big("한국 수능 부정행위", 0.14, Color3.new(1, 1, 1), 0.46)
	local subtitle = big("— 한 수험생의 길고 긴 하루 —", 0.04, Color3.fromRGB(180, 180, 180), 0.58, F.mid)
	title.TextTransparency, subtitle.TextTransparency = 1, 1
	TweenService:Create(title, TweenInfo.new(2), { TextTransparency = 0 }):Play()
	task.wait(1)
	TweenService:Create(subtitle, TweenInfo.new(2), { TextTransparency = 0 }):Play()
	task.wait(4)
	TweenService:Create(title, TweenInfo.new(1.5), { TextTransparency = 1 }):Play()
	TweenService:Create(subtitle, TweenInfo.new(1.5), { TextTransparency = 1 }):Play()
	task.wait(1.6)
	title:Destroy()
	subtitle:Destroy()

	-- 올라가는 자막
	local lines = {
		{ "출연", true },
		{ "수험생 · " .. player.DisplayName },
		{ "뉴비 감독관 · 뉴비 감독관" },
		{ "저격수 · 저격수 100명" },
		{ "매점 아주머니 · 매점 아주머니" },
		{ "부정행위 전문점 사장 · 전문점 사장" },
		{ "강화 장인 · 강화 장인" },
		{ "도로의 차 · 베이컨" },
		{ "주차장의 차 · 뉴비 차 50대" },
		{ "" },
		{ "특별 출연", true },
		{ "AI 안경 (성공률 100%)" },
		{ "1등급 상품권" },
		{ "핵폭탄 · 홍수 · 똥" },
		{ "" },
		{ "등장한 시험", true },
		{ "수능 · 서울대 · 면접 · 군대 · 인생 · 천국 · 할렐루야" },
		{ "K부대 훈련 25개" },
		{ "" },
		{ "촬영 장소", true },
		{ "교실 · 도로 · 매점 · 핵 벙커 · K부대" },
		{ "" },
		{ "이 게임의 모든 부정행위는 꿈입니다." },
		{ "실제 시험에서는 절대 따라 하지 마세요." },
		{ "" },
		{ "플레이해 주셔서 감사합니다", true },
	}
	local roll = new("Frame", { Parent = cg, BackgroundTransparency = 1, ZIndex = 5, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromScale(0.7, 0.06 * #lines), Position = UDim2.fromScale(0.5, 1) })
	for i, l in ipairs(lines) do
		text({ Parent = roll, ZIndex = 6, Text = l[1], Font = l[2] and F.bold or F.mid, TextScaled = true, TextColor3 = l[2] and Color3.fromRGB(255, 215, 120) or Color3.fromRGB(230, 230, 230), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 1 / #lines, -10), Position = UDim2.fromScale(0, (i - 1) / #lines) })
	end
	local dur = 22
	TweenService:Create(roll, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Position = UDim2.fromScale(0.5, -0.06 * #lines) }):Play()
	task.wait(dur)
	roll:Destroy()

	-- THE END
	local the = big("THE END", 0.16, Color3.new(1, 1, 1), 0.5)
	the.TextTransparency = 1
	TweenService:Create(the, TweenInfo.new(2), { TextTransparency = 0 }):Play()
	task.wait(4)
	TweenService:Create(the, TweenInfo.new(1.5), { TextTransparency = 1 }):Play()
	TweenService:Create(bg, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(barTop, TweenInfo.new(1.5), { Size = UDim2.fromScale(1, 0) }):Play()
	TweenService:Create(barBot, TweenInfo.new(1.5), { Size = UDim2.fromScale(1, 0) }):Play()
	task.wait(1.6)
	cg:Destroy()
end

